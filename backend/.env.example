# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional PostgreSQL)
# Local testing uses SQLite automatically if Postgres is not running. No Docker required.
# Optional Docker: postgres://camp:camp@localhost:5433/camp
# DATABASE_URL=postgres://camp:camp@localhost:5433/camp

# CORS – comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional contact info overrides
CONTACT_EMAIL=info@campsecurity.com
SALES_EMAIL=sales@campsecurity.com
CAREERS_EMAIL=careers@campsecurity.com
